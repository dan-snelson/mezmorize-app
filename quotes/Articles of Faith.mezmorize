{
  "exportedAt" : "2026-11-20T18:12:18Z",
  "format" : "us.snelson.mezmorize.quotes",
  "quotes" : [
    {
      "author" : "",
      "quote" : "We believe in God, the Eternal Father, and in His Son, Jesus Christ, and in the Holy Ghost.",
      "sourceReference" : "Articles of Faith 1:1\nhttps://www.churchofjesuschrist.org/study/scriptures/pgp/a-of-f/1?lang=eng&id=p1#p1",
      "sourceTitle" : "Pearl of Great Price"
    },
    {
      "author" : "",
      "quote" : "We believe that men will be punished for their own sins, and not for Adam’s transgression.",
      "sourceReference" : "Articles of Faith 1:2\nhttps://www.churchofjesuschrist.org/study/scriptures/pgp/a-of-f/1?lang=eng&id=p2#p2",
      "sourceTitle" : "Pearl of Great Price"
    },
    {
      "author" : "",
      "quote" : "We believe that through the Atonement of Christ, all mankind may be saved, by obedience to the laws and ordinances of the Gospel.",
      "sourceReference" : "Articles of Faith 1:3\nhttps://www.churchofjesuschrist.org/study/scriptures/pgp/a-of-f/1?lang=eng&id=p3#p3",
      "sourceTitle" : "Pearl of Great Price"
    },
    {
      "author" : "",
      "quote" : "We believe that the first principles and ordinances of the Gospel are: first, Faith in the Lord Jesus Christ; second, Repentance; third, Baptism by immersion for the remission of sins; fourth, Laying on of hands for the gift of the Holy Ghost.",
      "sourceReference" : "Articles of Faith 1:4\nhttps://www.churchofjesuschrist.org/study/scriptures/pgp/a-of-f/1?lang=eng&id=p4#p4",
      "sourceTitle" : "Pearl of Great Price"
    },
    {
      "author" : "",
      "quote" : "We believe that a man must be called of God, by prophecy, and by the laying on of hands by those who are in authority, to preach the Gospel and administer in the ordinances thereof.",
      "sourceReference" : "Articles of Faith 1:5\nhttps://www.churchofjesuschrist.org/study/scriptures/pgp/a-of-f/1?lang=eng&id=p5#p5",
      "sourceTitle" : "Pearl of Great Price"
    },
    {
      "author" : "",
      "quote" : "We believe in the same organization that existed in the Primitive Church, namely, apostles, prophets, pastors, teachers, evangelists, and so forth.",
      "sourceReference" : "Articles of Faith 1:6\nhttps://www.churchofjesuschrist.org/study/scriptures/pgp/a-of-f/1?lang=eng&id=p6#p6",
      "sourceTitle" : "Pearl of Great Price"
    },
    {
      "author" : "",
      "quote" : "We believe in the gift of tongues, prophecy, revelation, visions, healing, interpretation of tongues, and so forth.",
      "sourceReference" : "Articles of Faith 1:7\nhttps://www.churchofjesuschrist.org/study/scriptures/pgp/a-of-f/1?lang=eng&id=p7#p7",
      "sourceTitle" : "Pearl of Great Price"
    },
    {
      "author" : "",
      "quote" : "We believe the Bible to be the word of God as far as it is translated correctly; we also believe the Book of Mormon to be the word of God.",
      "sourceReference" : "Articles of Faith 1:8\nhttps://www.churchofjesuschrist.org/study/scriptures/pgp/a-of-f/1?lang=eng&id=p8#p8",
      "sourceTitle" : "Pearl of Great Price"
    },
    {
      "author" : "",
      "quote" : "We believe all that God has revealed, all that He does now reveal, and we believe that He will yet reveal many great and important things pertaining to the Kingdom of God.",
      "sourceReference" : "Articles of Faith 1:9\nhttps://www.churchofjesuschrist.org/study/scriptures/pgp/a-of-f/1?lang=eng&id=p9#p9",
      "sourceTitle" : "Pearl of Great Price"
    },
    {
      "author" : "",
      "quote" : "We believe in the literal gathering of Israel and in the restoration of the Ten Tribes; that Zion (the New Jerusalem) will be built upon the American continent; that Christ will reign personally upon the earth; and, that the earth will be renewed and receive its paradisiacal glory.",
      "sourceReference" : "Articles of Faith 1:10\nhttps://www.churchofjesuschrist.org/study/scriptures/pgp/a-of-f/1?lang=eng&id=p10#p10",
      "sourceTitle" : "Pearl of Great Price"
    },
    {
      "author" : "",
      "quote" : "We claim the privilege of worshiping Almighty God according to the dictates of our own conscience, and allow all men the same privilege, let them worship how, where, or what they may.",
      "sourceReference" : "Articles of Faith 1:11\nhttps://www.churchofjesuschrist.org/study/scriptures/pgp/a-of-f/1?lang=eng&id=p11#p11",
      "sourceTitle" : "Pearl of Great Price"
    },
    {
      "author" : "",
      "quote" : "We believe in being subject to kings, presidents, rulers, and magistrates, in obeying, honoring, and sustaining the law.",
      "sourceReference" : "Articles of Faith 1:12\nhttps://www.churchofjesuschrist.org/study/scriptures/pgp/a-of-f/1?lang=eng&id=p12#p12",
      "sourceTitle" : "Pearl of Great Price"
    },
    {
      "author" : "",
      "quote" : "We believe in being honest, true, chaste, benevolent, virtuous, and in doing good to all men; indeed, we may say that we follow the admonition of Paul—We believe all things, we hope all things, we have endured many things, and hope to be able to endure all things. If there is anything virtuous, lovely, or of good report or praiseworthy, we seek after these things.",
      "sourceReference" : "Articles of Faith 1:13\nhttps://www.churchofjesuschrist.org/study/scriptures/pgp/a-of-f/1?lang=eng&id=p13#p13",
      "sourceTitle" : "Pearl of Great Price"
    }
  ],
  "version" : 1
}
